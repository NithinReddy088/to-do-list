{
  "name": "to-do-list-server",
  "version": "1.0.0",
  "description": "To-do backend: auth, sync, self-hosted OTA",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --env-file=env/.env.local --watch src/index.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "test": "bun test --env-file=env/.env.local",
    "db:generate": "bun --env-file=env/.env.local x prisma generate",
    "db:migrate": "bun --env-file=env/.env.local x prisma migrate dev",
    "db:migrate:deploy": "bun --env-file=env/.env.local x prisma migrate deploy",
    "db:studio": "bun --env-file=env/.env.local x prisma studio",
    "db:seed": "bun run --env-file=env/.env.local scripts/seed-demo-user.ts",
    "codesign:generate": "bun run scripts/generate-codesign-keys.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/jwt": "^1.1.1",
    "@elysiajs/swagger": "^1.1.6",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "elysia": "^1.1.27",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ulid": "^3.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "prisma": "^7.5.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "bun@1.3.6"
}
