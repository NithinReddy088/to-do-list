NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://todo:todo@localhost:5433/todo?schema=public
JWT_SECRET=dev-change-me-please-32chars-minimum
ADMIN_PUBLISH_TOKEN=dev-admin-token-change-me
UPDATES_STORAGE_DIR=./updates
# Public base URL the mobile app uses to reach the updates server.
PUBLIC_BASE_URL=http://localhost:4000
# Path to the RSA private key used to sign OTA manifests (see codesign:generate).
CODE_SIGNING_PRIVATE_KEY_PATH=./keys/private-key.pem
