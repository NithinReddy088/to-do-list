NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/todo?schema=public
JWT_SECRET=<generate a long random secret>
ADMIN_PUBLISH_TOKEN=<generate a long random token>
UPDATES_STORAGE_DIR=./updates
# Public HTTPS URL of this backend (e.g. an Oracle VM + free DuckDNS domain):
PUBLIC_BASE_URL=https://to-do-list.duckdns.org
CODE_SIGNING_PRIVATE_KEY_PATH=./keys/private-key.pem
